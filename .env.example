# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# MongoDB connection string (MongoDB Atlas: Connect > Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/stackmeet?appName=Cluster0

# Secret used to protect sessions. Generate one with: npx auth secret
AUTH_SECRET=your-auth-secret

# Cloudinary connection URL, used for event cover images (Cloudinary dashboard: API Keys)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Base URL of the app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PostHog project API key, used for analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key

# Optional, dev only: your computer's local Wi-Fi IP (from ipconfig), to open the dev server
# from a phone on the same Wi-Fi. Then run: npm run dev -- --hostname 0.0.0.0
# Leave it out in production.
DEV_ORIGIN=192.x.x.x
